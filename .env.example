APP_ENV=development
SECRET_KEY=change-me
API_KEY=change-me-at-least-32-characters
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://jumpbot:change-me@postgres:5432/jumpbot
